# --- generated intermediates ---
# 68 MB of per-run scenario CSVs and the .RData the original R stage wrote.
# Regenerated by `python scripts/run_all.py`.
csvs/
*.RData
*.rdata

# The precipitation scenarios live in data/raw/ and are the INPUT OF RECORD.
# They are generated -- 100,000 Monte Carlo draws each -- yet nothing runs
# without them, so they ship as a documented exception. `markov.simulate` writes
# a fresh sample to results/regenerated/ and never over these: an input a later
# stage can overwrite is not an input.

# --- results ---
# Everything under results/ is regenerated, EXCEPT the headline tables. Those
# are committed so a reader without a Gurobi licence sees the outputs without
# running anything -- rule 5's documented exception, stated in the README.
results/**
!results/.gitkeep
!results/solnvalues.csv
!results/simstatstrad.csv
!results/first_stage.csv
!results/expected_value_diagnostic.csv

# Stage 7, cleaned output: tidy, long, and what every figure and analysis reads.
# Committed because without it nothing works from a clean clone. 90 KB, against
# 135 MB of per-run RAW output above.
!results/clean/
!results/clean/**

# Rendered reports are ~1 MB each and regenerate in seconds; the tables above
# carry every number in them.
results/regenerated/

# --- Jupyter autosaves. These put a 76.8 MiB and a 24.1 MiB blob into the
#     original repository's history, where they remain permanently. ---
.ipynb_checkpoints/

# --- credentials ---
gurobi.lic
*.lic
gamslice.txt
.env
*_key*
gurobi.log

# --- Python ---
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/

# --- R ---
.Rproj.user/
.Rhistory
.Ruserdata
*_files/
*_cache/
